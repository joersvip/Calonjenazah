# ==========================================
# PORTAL BERITA CALON JENAZAH - PRODUCTION CONFIG
# ==========================================

# Port aplikasi
PORT=5000

# Environment mode (production / development)
NODE_ENV=production

# Kunci rahasia untuk tanda tangan token sesi admin (HMAC-SHA256)
# Ganti dengan deretan karakter acak minimal 32 karakter
SESSION_SECRET=kunci_rahasia_acak_minimal_32_karakter_untuk_keamanan_sesi

# Kredensial akun admin pertama kali saat database diinisialisasi
# Password akan otomatis di-hash dengan PBKDF2 salt dan tidak disimpan sebagai plain text
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=GantiDenganPasswordKuatAnda
